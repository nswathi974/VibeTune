# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection String
# Replace <username>, <password>, and <cluster-url> with your MongoDB Atlas details:
# Example: mongodb+srv://vibetune_admin:YourPassword123@cluster0.abcde.mongodb.net/vibetune_db?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/vibetune_db?retryWrites=true&w=majority

# JWT Authentication Secret Key (Any random 32+ character string)
JWT_SECRET=vibetune_secure_mca_project_jwt_secret_key_2026_change_in_production
JWT_EXPIRE=30d

# Hosted AI Vocal Separation Engine (Demucs via Replicate)
# Obtain your token at: https://replicate.com/account/api-tokens
# Model: cjwbw/demucs (htdemucs)
# When set, real AI vocal separation runs through Replicate API.
# Never commit this token to git or expose in client code.
REPLICATE_API_TOKEN=r8_your_actual_replicate_api_token_here

# Offline / Test Mode for Vocal Separation (true = mock separation with 0 API cost)
USE_MOCK_SEPARATION=false
